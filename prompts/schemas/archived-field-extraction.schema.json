{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "旧版统一字段提取（已归档）",
  "description": "已归档，不再参考使用",
  "type": "object",
  "oneOf": [
    {
      "title": "旧版统一字段提取（已归档） - 正常解析结果",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "案号",
        "原告/申请人",
        "被告/被申请人",
        "涉及主体",
        "涉及客户",
        "业务类型",
        "标准案由",
        "受理法院/仲裁委",
        "代理人信息",
        "标的额",
        "赔偿金",
        "诉讼请求金额",
        "立案日期",
        "开庭日期",
        "裁判日期",
        "提取说明"
      ],
      "properties": {
        "案号": {
          "type": [
            "string",
            "null"
          ],
          "description": "完整案号 或 null"
        },
        "原告/申请人": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "实体名称列表；未识别到则为 null"
        },
        "被告/被申请人": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "实体名称列表；未识别到则为 null"
        },
        "涉及主体": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "实体名称列表；未识别到则为 null"
        },
        "涉及客户": {
          "type": [
            "string",
            "null"
          ],
          "description": "客户名称 或 null"
        },
        "业务类型": {
          "type": [
            "string",
            "null"
          ],
          "description": "业务类型 或 null"
        },
        "标准案由": {
          "type": [
            "string",
            "null"
          ],
          "description": "标准案由 或 null"
        },
        "受理法院/仲裁委": {
          "type": [
            "string",
            "null"
          ],
          "description": "法院/仲裁委全称 或 null"
        },
        "代理人信息": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "姓名"
            ],
            "properties": {
              "姓名": {
                "type": "string"
              },
              "律所": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "身份": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "description": "代理人列表；未识别到则为 null"
        },
        "标的额": {
          "type": [
            "number",
            "null"
          ],
          "description": "数值(元) 或 null"
        },
        "赔偿金": {
          "type": [
            "number",
            "null"
          ],
          "description": "数值(元) 或 null"
        },
        "诉讼请求金额": {
          "type": [
            "number",
            "null"
          ],
          "description": "数值(元) 或 null"
        },
        "立案日期": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "YYYY-MM-DD 或 null"
        },
        "开庭日期": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "YYYY-MM-DD 或 null"
        },
        "裁判日期": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "YYYY-MM-DD 或 null"
        },
        "提取说明": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "案号",
            "原告/申请人",
            "被告/被申请人",
            "涉及主体",
            "涉及客户",
            "业务类型",
            "标准案由",
            "受理法院/仲裁委",
            "代理人信息",
            "标的额",
            "赔偿金",
            "诉讼请求金额",
            "立案日期",
            "开庭日期",
            "裁判日期"
          ],
          "properties": {
            "案号": {
              "type": "string",
              "enum": [
                "已提取",
                "未命中案号"
              ],
              "description": "已提取 | 未命中案号"
            },
            "原告/申请人": {
              "type": "string",
              "description": "已提取N个 | 未命中触发词 | 触发词命中但未识别到实体"
            },
            "被告/被申请人": {
              "type": "string",
              "description": "已提取N个 | 未命中触发词 | 触发词命中但未识别到实体"
            },
            "涉及主体": {
              "type": "string",
              "description": "已提取N个 | 无可识别主体"
            },
            "涉及客户": {
              "type": "string",
              "enum": [
                "已提取",
                "文书未包含委托代理信息",
                "委托关系存在但被代理方无法确定"
              ],
              "description": "已提取 | 文书未包含委托代理信息 | 委托关系存在但被代理方无法确定"
            },
            "业务类型": {
              "type": "string",
              "description": "已提取:由标准案由反查 | 无法根据已有信息推断 | 未匹配到已知案由"
            },
            "标准案由": {
              "type": "string",
              "description": "已提取:命中关键词XXX | 未匹配到已知案由"
            },
            "受理法院/仲裁委": {
              "type": "string",
              "description": "已提取:从案号还原 | 已提取:全文匹配 | 未命中；层级:基层|中级|高级|最高|仲裁委"
            },
            "代理人信息": {
              "type": "string",
              "description": "已提取N个 | 未命中触发词 | 触发词命中但未识别到实体"
            },
            "标的额": {
              "type": "string",
              "description": "已提取:原始文本XXX | 未命中触发词 | 触发词命中但未匹配到金额"
            },
            "赔偿金": {
              "type": "string",
              "description": "已提取:原始文本XXX | 未命中触发词 | 触发词命中但未匹配到金额"
            },
            "诉讼请求金额": {
              "type": "string",
              "description": "已提取:原始文本XXX | 未命中触发词 | 触发词命中但未匹配到金额"
            },
            "立案日期": {
              "type": "string",
              "description": "已提取:YYYY-MM-DD | 未命中触发词 | 触发词命中但未匹配到日期"
            },
            "开庭日期": {
              "type": "string",
              "description": "已提取:YYYY-MM-DD | 未命中触发词 | 触发词命中但未匹配到日期"
            },
            "裁判日期": {
              "type": "string",
              "description": "已提取:YYYY-MM-DD | 未命中触发词 | 触发词命中但未匹配到日期"
            }
          }
        }
      }
    },
    {
      "title": "旧版统一字段提取（已归档） - 不在解析范围内",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "错误"
      ],
      "properties": {
        "错误": {
          "type": "string",
          "const": "该文书不在可解析范围内"
        }
      }
    }
  ]
}
