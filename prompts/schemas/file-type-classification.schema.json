{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "文书类型判定结果",
  "description": "仅判定文书类型，不提取字段",
  "type": "object",
  "oneOf": [
    {
      "title": "文书类型判定结果 - 正常解析结果",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "文书类型",
        "是否需解析",
        "判定依据"
      ],
      "properties": {
        "文书类型": {
          "type": "string",
          "description": "类型名称 或 证据材料/程序性附件具体类型 或 未知类型"
        },
        "是否需解析": {
          "type": "string",
          "enum": [
            "是",
            "否"
          ],
          "description": "是 | 否"
        },
        "判定依据": {
          "type": "string",
          "description": "命中的关键词列表 或 匹配的材料类别 或 未匹配任何类型"
        }
      }
    },
    {
      "title": "文书类型判定结果 - 不在解析范围内",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "错误"
      ],
      "properties": {
        "错误": {
          "type": "string",
          "const": "该文书不在可解析范围内"
        }
      }
    }
  ]
}
