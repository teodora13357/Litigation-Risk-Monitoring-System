{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "举证通知书字段提取",
  "description": "按固定 JSON 结构提取举证通知书字段",
  "type": "object",
  "oneOf": [
    {
      "title": "举证通知书字段提取 - 正常解析结果",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "案号",
        "被告/被申请人",
        "涉及主体",
        "受理法院/仲裁委",
        "标准案由",
        "业务类型",
        "举证期限",
        "提取说明"
      ],
      "properties": {
        "案号": {
          "type": [
            "string",
            "null"
          ],
          "description": "完整案号 或 null"
        },
        "被告/被申请人": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "实体名称列表；未识别到则为 null"
        },
        "涉及主体": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "实体名称列表；未识别到则为 null"
        },
        "受理法院/仲裁委": {
          "type": [
            "string",
            "null"
          ],
          "description": "法院/仲裁委全称 或 null"
        },
        "标准案由": {
          "type": [
            "string",
            "null"
          ],
          "description": "标准案由 或 null"
        },
        "业务类型": {
          "type": [
            "string",
            "null"
          ],
          "description": "业务类型 或 null"
        },
        "举证期限": {
          "type": [
            "string",
            "null"
          ],
          "description": "YYYY-MM-DD 或 N日内 或 null"
        },
        "提取说明": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "案号",
            "被告/被申请人",
            "涉及主体",
            "受理法院/仲裁委",
            "标准案由",
            "业务类型",
            "举证期限"
          ],
          "properties": {
            "案号": {
              "type": "string",
              "enum": [
                "已提取",
                "未命中案号"
              ],
              "description": "已提取 | 未命中案号"
            },
            "被告/被申请人": {
              "type": "string",
              "description": "已提取N个 | 未命中触发词 | 触发词命中但未识别到实体"
            },
            "涉及主体": {
              "type": "string",
              "description": "已提取N个 | 无可识别主体"
            },
            "受理法院/仲裁委": {
              "type": "string",
              "description": "已提取:从案号还原 | 已提取:全文匹配 | 未命中；层级:基层|中级|高级|最高|仲裁委"
            },
            "标准案由": {
              "type": "string",
              "description": "已提取:命中关键词XXX | 未匹配到已知案由"
            },
            "业务类型": {
              "type": "string",
              "description": "已提取:由标准案由反查 | 无法根据已有信息推断 | 未匹配到已知案由"
            },
            "举证期限": {
              "type": "string",
              "description": "已提取:YYYY-MM-DD 或 N日内 | 文书未包含举证期限信息 | 举证期限信息无法解析"
            }
          }
        }
      }
    },
    {
      "title": "举证通知书字段提取 - 不在解析范围内",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "错误"
      ],
      "properties": {
        "错误": {
          "type": "string",
          "const": "该文书不在可解析范围内"
        }
      }
    }
  ]
}
