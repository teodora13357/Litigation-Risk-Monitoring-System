# ============================================================
# 案件管理系统 —— 环境变量示例
# 使用方法：cp .env.example .env 后按需修改
#
# ⚠️ Docker Compose 部署时：
#   - PG_HOST / REDIS_URL / MINERU_API_URL 使用容器服务名（默认值已填好）
#   - 请务必修改：PG_PASSWORD、SECRET_KEY
# ⚠️ macOS 本地开发时：
#   - 将 PG_HOST 改为 127.0.0.1，REDIS_URL 改为 redis://127.0.0.1:6379/0，
#     MINERU_API_URL 改为 http://localhost:30000
# ============================================================

# ---------- 数据库（PostgreSQL） ----------
PG_HOST=postgres
PG_PORT=5432
PG_USER=case_app
# 生产环境务必修改为强密码
PG_PASSWORD=case_pass_123
PG_DB=case_management
# 可选：完整连接串（优先级最高，配置后忽略上面 PG_* 项）
# DATABASE_URL=postgresql+psycopg2://case_app:case_pass_123@postgres:5432/case_management

# ---------- Redis（可选，预留缓存模块） ----------
REDIS_URL=redis://redis:6379/0

# ---------- JWT 密钥 ----------
# 生产环境务必修改：可用 `python -c "import secrets; print(secrets.token_urlsafe(48))"` 生成
SECRET_KEY=case-management-secret-key-change-me

# ---------- MinerU OCR 服务 ----------
MINERU_API_URL=http://mineru:30000
# 单批解析超时（秒）
OCR_PARSE_TIMEOUT=600
# 每批提交页数
OCR_BATCH_PAGES=10
# PDF 渲染 DPI
OCR_PREPROCESS_DPI=300
# 图像长边上限（px）
OCR_MAX_IMAGE_SIDE=3500
# 二值化策略：auto / true / false
OCR_BINARIZE=auto
# PDF 内嵌文本判定阈值（字符）
OCR_TEXT_MIN_CHARS=30
